<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CuentaActivity">

    <!-- Contenedor principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mi Cuenta"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Nombre -->
        <TextView
            android:id="@+id/tvNombreUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre: -"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <!-- Correo -->
        <TextView
            android:id="@+id/tvCorreoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo: -"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <!-- Estado 2FA // NO HACE NADA -->
        <TextView
            android:id="@+id/tvEstado2FA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2FA: Deshabilitado"
            android:textSize="18sp"
            android:layout_marginBottom="24dp" />

        <!-- Botón activar/desactivar 2FA -->
        <Button
            android:id="@+id/btnToggle2FA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Habilitar 2FA"
            android:layout_marginBottom="16dp" />

        <!-- Botón cerrar sesión -->
        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar sesión"
            android:backgroundTint="@android:color/holo_red_light" />
    </LinearLayout>

    <!-- 🔹 Barra inferior de navegación -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/black"
        app:itemTextColor="@color/black" />

</LinearLayout>
